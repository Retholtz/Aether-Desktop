{
  "schema_version": 1,
  "module_id": "elite_dangerous",
  "display_name": "Elite Dangerous",
  "game_ids": [
    "elite_dangerous",
    "elite_dangerous_64"
  ],
  "executables": [
    "EliteDangerous64.exe",
    "EDLaunch.exe"
  ],
  "universe_name": "Milky Way",
  "default_callsign": "Commander",
  "input_mode": "autonomous",
  "navigation_mode": "search_bar",
  "suppress_alerts_when_running": [
    "EDCoPilot.exe"
  ],
  "map_controls": {
    "preferred_input": "mouse_keyboard",
    "search_routing": {
      "map_open_actions": [
        "open galaxy map",
        "galaxy map open",
        "GalaxyMapOpen"
      ],
      "map_key": "m",
      "open_wait_sec": 1.4,
      "search_box_visual_hint": "Galaxy Map search text box labeled 'Search' near the top of the screen",
      "input_method": "clipboard_paste",
      "submit_key": "",
      "select_result_wait_sec": 0.7,
      "post_input_keys": [
        { "key": "down", "delay_ms": 350 },
        { "key": "enter", "delay_ms": 1200 }
      ],
      "plot_visual_hint": "Route Plotter / Plot Route button icon on the right-hand system info sidebar",
      "prefer_plot_key_first": true,
      "pre_plot_move_center": true,
      "pre_plot_mouse_nudge": [15, 10],
      "plot_key": "space",
      "plot_hold_sec": 1.25,
      "verify_telemetry_field": "route_destination",
      "verify_timeout_sec": 3.0
    }
  },
  "binds_scanner": {
    "format": "xml_primary_secondary",
    "dir": "%LOCALAPPDATA%\\Frontier Developments\\Elite Dangerous\\Options\\Bindings",
    "file_glob": "*.binds",
    "preset_pointer_file": "StartPreset.4.start",
    "key_prefix": "Key_",
    "device_priority": [
      "Keyboard",
      "Mouse",
      "GamePad",
      "Controller"
    ],
    "auto_import_all": true,
    "actions": {
      "DeployHeatSink": {
        "phrase": "deploy heat sink",
        "description": "Deploy Heat Sink",
        "aliases": ["heat sink", "pop heat sink", "fire heat sink"]
      },
      "ToggleFlightAssist": {
        "phrase": "toggle flight assist",
        "description": "Toggle Flight Assist",
        "aliases": ["flight assist", "fa off", "fa on"]
      },
      "ChargeECM": {
        "phrase": "charge ecm",
        "description": "Charge ECM",
        "aliases": ["ecm", "fire ecm"]
      },
      "UseShieldCell": {
        "phrase": "use shield cell",
        "description": "Fire Shield Cell Bank",
        "aliases": ["shield cell", "pop shield cell", "scb"]
      },
      "FireChaffLauncher": {
        "phrase": "fire chaff",
        "description": "Fire Chaff Launcher",
        "aliases": ["deploy chaff", "chaff"]
      },
      "IncreaseEnginesPower": {
        "phrase": "divert power to engines",
        "description": "Power to Engines",
        "aliases": ["power to engines", "pips to engines"]
      },
      "IncreaseWeaponsPower": {
        "phrase": "divert power to weapons",
        "description": "Power to Weapons",
        "aliases": ["power to weapons", "pips to weapons"]
      },
      "IncreaseSystemsPower": {
        "phrase": "divert power to systems",
        "description": "Power to Systems",
        "aliases": ["power to systems", "pips to systems", "power to shields"]
      },
      "ResetPowerDistribution": {
        "phrase": "balance power",
        "description": "Balance Power Distribution",
        "aliases": ["reset power", "equalize power"]
      },
      "ToggleCargoScoop": {
        "phrase": "toggle cargo scoop",
        "description": "Toggle Cargo Scoop",
        "aliases": ["cargo scoop"],
        "variants": [
          {
            "phrase": "open cargo scoop",
            "description": "Open Cargo Scoop",
            "condition": "!state.cargo_scoop_open",
            "condition_skip_ack": "Cargo scoop is already open.",
            "aliases": ["deploy cargo scoop"]
          },
          {
            "phrase": "close cargo scoop",
            "description": "Close Cargo Scoop",
            "condition": "state.cargo_scoop_open",
            "condition_skip_ack": "Cargo scoop is already closed.",
            "aliases": ["retract cargo scoop"]
          }
        ]
      },
      "LandingGearToggle": {
        "phrase": "deploy landing gear",
        "description": "Toggle Landing Gear",
        "condition": "!state.landing_gear_down",
        "condition_skip_ack": "Landing gear is already deployed.",
        "variants": [
          {
            "phrase": "lower landing gear",
            "description": "Toggle Landing Gear",
            "condition": "!state.landing_gear_down",
            "condition_skip_ack": "Landing gear is already down.",
            "aliases": ["deploy landing gear"]
          },
          {
            "phrase": "retract landing gear",
            "description": "Retract Landing Gear",
            "condition": "state.landing_gear_down",
            "condition_skip_ack": "Landing gear is already retracted.",
            "aliases": ["raise landing gear", "landing gear up"]
          }
        ]
      },
      "DeployHardpointToggle": {
        "phrase": "deploy hardpoints",
        "description": "Toggle Hardpoints",
        "condition": "!state.hardpoints_deployed",
        "condition_skip_ack": "Hardpoints are already deployed.",
        "variants": [
          {
            "phrase": "draw weapons",
            "description": "Toggle Hardpoints",
            "condition": "!state.hardpoints_deployed",
            "aliases": ["deploy hardpoints"]
          },
          {
            "phrase": "retract hardpoints",
            "description": "Retract Hardpoints",
            "condition": "state.hardpoints_deployed",
            "condition_skip_ack": "Hardpoints are already retracted.",
            "aliases": ["stow weapons", "sheathe weapons"]
          }
        ]
      },
      "SelectTarget": {
        "phrase": "target ahead",
        "description": "Target Ahead",
        "aliases": ["select target"]
      },
      "CycleNextTarget": {
        "phrase": "next target",
        "description": "Target Next",
        "aliases": ["cycle next target"]
      },
      "CyclePreviousTarget": {
        "phrase": "previous target",
        "description": "Target Previous"
      },
      "SelectHighestThreat": {
        "phrase": "target highest threat",
        "description": "Target Highest Threat",
        "aliases": ["highest threat"]
      },
      "CycleNextHostileTarget": {
        "phrase": "next hostile",
        "description": "Target Next Hostile",
        "aliases": ["target next hostile"]
      },
      "CycleNextSubsystem": {
        "phrase": "next subsystem",
        "description": "Cycle Next Subsystem"
      },
      "CycleFireGroupNext": {
        "phrase": "next fire group",
        "description": "Cycle Next Fire Group"
      },
      "CycleFireGroupPrevious": {
        "phrase": "previous fire group",
        "description": "Cycle Previous Fire Group"
      },
      "HyperSuperCombination": {
        "phrase": "frame shift drive",
        "description": "Toggle Frame Shift Drive",
        "aliases": ["engage fsd", "jump", "engage jump"]
      },
      "Supercruise": {
        "phrase": "enter supercruise",
        "description": "Toggle Supercruise",
        "aliases": ["supercruise", "engage supercruise"]
      },
      "Hyperspace": {
        "phrase": "hyperspace jump",
        "description": "Engage Hyperspace Jump",
        "aliases": ["high wake"]
      },
      "TargetNextRouteSystem": {
        "phrase": "target next system in route",
        "description": "Target Next System in Route",
        "aliases": ["next route system", "next jump"]
      },
      "GalaxyMapOpen": {
        "phrase": "open galaxy map",
        "description": "Open Galaxy Map",
        "aliases": ["galaxy map"]
      },
      "SystemMapOpen": {
        "phrase": "open system map",
        "description": "Open System Map",
        "aliases": ["system map"]
      },
      "UI_Back": {
        "phrase": "close menu",
        "description": "Back / Close Map or Menu",
        "aliases": ["close map", "close galaxy map", "close system map", "back", "exit menu", "escape"]
      },
      "ShipSpotLightToggle": {
        "phrase": "toggle ship lights",
        "description": "Toggle Ship Lights",
        "aliases": ["ship lights", "lights", "headlights"]
      },
      "NightVisionToggle": {
        "phrase": "toggle night vision",
        "description": "Toggle Night Vision",
        "aliases": ["night vision"]
      },
      "ToggleButtonUpInput": {
        "phrase": "silent running",
        "description": "Toggle Silent Running",
        "aliases": ["toggle silent running", "engage silent running"]
      },
      "OrbitLinesToggle": {
        "phrase": "toggle orbit lines",
        "description": "Toggle Orbit Lines",
        "aliases": ["orbit lines"]
      },
      "PlayerHUDModeToggle": {
        "phrase": "switch hud mode",
        "description": "Toggle Combat / Analysis HUD Mode",
        "aliases": ["analysis mode", "combat mode", "toggle hud mode"]
      },
      "ExplorationFSSEnter": {
        "phrase": "open fss",
        "description": "Enter Full Spectrum System Scanner",
        "aliases": ["fss", "open scanner"]
      },
      "UseBoostJuice": {
        "phrase": "boost",
        "description": "Engine Boost",
        "aliases": ["afterburner", "engage boost"]
      },
      "SetSpeedZero": {
        "phrase": "all stop",
        "description": "Set Throttle to 0%",
        "aliases": ["zero throttle", "stop engines", "cut throttle"]
      },
      "SetSpeed25": {
        "phrase": "quarter impulse",
        "description": "Set Throttle to 25%",
        "aliases": ["throttle 25"]
      },
      "SetSpeed50": {
        "phrase": "half impulse",
        "description": "Set Throttle to 50%",
        "aliases": ["throttle 50"]
      },
      "SetSpeed75": {
        "phrase": "three quarter throttle",
        "description": "Set Throttle to 75%",
        "aliases": ["throttle 75", "75 percent throttle"]
      },
      "SetSpeed100": {
        "phrase": "full throttle",
        "description": "Set Throttle to 100%",
        "aliases": ["throttle 100", "full ahead"]
      },
      "FocusLeftPanel": {
        "phrase": "left panel",
        "description": "Focus Navigation / Left Panel",
        "aliases": ["navigation panel"]
      },
      "FocusCommsPanel": {
        "phrase": "comms panel",
        "description": "Focus Comms Panel"
      },
      "FocusRadarPanel": {
        "phrase": "role panel",
        "description": "Focus Role / Bottom Panel"
      },
      "FocusRightPanel": {
        "phrase": "right panel",
        "description": "Focus Systems / Right Panel",
        "aliases": ["systems panel", "internal panel"]
      }
    }
  },
  "sequences": {
    "take us out": {
      "description": "Click Auto Launch on station/carrier menu when docked",
      "condition": "state.docked",
      "condition_skip_ack": "We are not currently docked at a station or carrier.",
      "ack": "Engaging Auto Launch, Commander.",
      "aliases": ["auto launch", "launch ship", "undock"],
      "sync": true,
      "steps": [
        {
          "action": "vision_click",
          "target": "Auto Launch button in the station or carrier services menu",
          "button": "left",
          "hold_ms": 100,
          "abort_if_not_found": true,
          "delay_ms": 200
        }
      ]
    }
  },
  "companion_resources": {
    "market": {
      "name": "Inara / Spansh",
      "domain": "spansh.co.uk"
    },
    "navigation": {
      "name": "Spansh",
      "domain": "spansh.co.uk"
    },
    "outfitting": {
      "name": "Spansh Outfitting",
      "domain": "spansh.co.uk"
    },
    "services": {
      "name": "Spansh Station Services",
      "domain": "spansh.co.uk"
    }
  },
  "intel_endpoints": {
    "market": {
      "name": "Spansh Live Commodity Market (EDDN)",
      "method": "POST",
      "url": "https://spansh.co.uk/api/stations/search",
      "default_location": "Sol",
      "timeout_sec": 12.0,
      "max_results": 5,
      "fallback_to_web_search": true,
      "value_resolver": {
        "url": "https://spansh.co.uk/api/stations/field_values/market",
        "values_path": "values"
      },
      "body_template": {
        "filters": {
          "market": [
            {
              "name": "{canonical_query}",
              "supply": {
                "comparison": "<=>",
                "value": [1, 999999999]
              }
            }
          ],
          "has_large_pad": {
            "$if": "telemetry.needs_large_pad",
            "$value": {
              "value": true
            }
          }
        },
        "reference_system": "{location}",
        "sort": [
          {
            "distance": {
              "direction": "asc"
            }
          }
        ],
        "size": 5
      },
      "results_path": "results",
      "result_fields": {
        "system": "system_name",
        "station": "name",
        "station_type": "type",
        "distance_ly": "distance",
        "distance_ls": "distance_to_arrival",
        "large_pads": "large_pads",
        "medium_pads": "medium_pads",
        "buy_price_cr": "market[commodity~={canonical_query}].buy_price",
        "supply": "market[commodity~={canonical_query}].supply",
        "sell_price_cr": "market[commodity~={canonical_query}].sell_price",
        "demand": "market[commodity~={canonical_query}].demand"
      }
    },
    "outfitting": {
      "name": "Spansh Live Outfitting Search (EDDN)",
      "method": "POST",
      "url": "https://spansh.co.uk/api/stations/search",
      "default_location": "Sol",
      "timeout_sec": 12.0,
      "max_results": 5,
      "fallback_to_web_search": true,
      "value_resolver": {
        "url": "https://spansh.co.uk/api/stations/field_values/modules",
        "values_path": "values.name"
      },
      "body_template": {
        "filters": {
          "modules": [
            {
              "name": "{canonical_query}"
            }
          ],
          "has_large_pad": {
            "$if": "telemetry.needs_large_pad",
            "$value": {
              "value": true
            }
          }
        },
        "reference_system": "{location}",
        "sort": [
          {
            "distance": {
              "direction": "asc"
            }
          }
        ],
        "size": 5
      },
      "results_path": "results",
      "result_fields": {
        "system": "system_name",
        "station": "name",
        "station_type": "type",
        "distance_ly": "distance",
        "distance_ls": "distance_to_arrival",
        "large_pads": "large_pads",
        "medium_pads": "medium_pads"
      }
    },
    "services": {
      "name": "Spansh Live Station Services Search (EDDN)",
      "method": "POST",
      "url": "https://spansh.co.uk/api/stations/search",
      "default_location": "Sol",
      "timeout_sec": 12.0,
      "max_results": 5,
      "fallback_to_web_search": true,
      "value_resolver": {
        "url": "https://spansh.co.uk/api/stations/field_values/services",
        "values_path": "values.name"
      },
      "body_template": {
        "filters": {
          "services": {
            "value": [
              "{canonical_query}"
            ]
          },
          "has_large_pad": {
            "$if": "telemetry.needs_large_pad",
            "$value": {
              "value": true
            }
          }
        },
        "reference_system": "{location}",
        "sort": [
          {
            "distance": {
              "direction": "asc"
            }
          }
        ],
        "size": 5
      },
      "results_path": "results",
      "result_fields": {
        "system": "system_name",
        "station": "name",
        "station_type": "type",
        "distance_ly": "distance",
        "distance_ls": "distance_to_arrival",
        "large_pads": "large_pads",
        "medium_pads": "medium_pads"
      }
    },
    "navigation": {
      "name": "Spansh Star System Search",
      "method": "POST",
      "url": "https://spansh.co.uk/api/systems/search",
      "default_location": "Sol",
      "timeout_sec": 12.0,
      "max_results": 5,
      "fallback_to_web_search": true,
      "body_template": {
        "filters": {
          "name": {
            "value": "{query}"
          }
        },
        "reference_system": "{location}",
        "sort": [
          {
            "distance": {
              "direction": "asc"
            }
          }
        ],
        "size": 5
      },
      "results_path": "results",
      "result_fields": {
        "system": "name",
        "distance_ly": "distance",
        "controlling_power": "controlling_power",
        "power_state": "power_state",
        "powers": "power",
        "controlling_minor_faction": "controlling_minor_faction",
        "controlling_minor_faction_state": "controlling_minor_faction_state",
        "allegiance": "allegiance",
        "government": "government",
        "primary_economy": "primary_economy",
        "security": "security",
        "population": "population"
      }
    }
  },
  "telemetry": {
    "adapter": "declarative_file",
    "provider_type": "native_file",
    "poll_interval_sec": 0.25,
    "dir": "%USERPROFILE%\\Saved Games\\Frontier Developments\\Elite Dangerous",
    "status_file": "Status.json",
    "native_file_path": "%USERPROFILE%\\Saved Games\\Frontier Developments\\Elite Dangerous\\Status.json",
    "journal_glob": "Journal.*.log",
    "event_field": "event",
    "rehydrate_lines": 150,
    "companion_files": [
      "NavRoute.json",
      "Cargo.json",
      "Market.json"
    ],
    "location_fields": {
      "system": "star_system",
      "station": "station",
      "body": "body",
      "star_pos": "star_pos"
    },
    "initial_state": {
      "star_system": "Unknown",
      "body": "Unknown",
      "station": null,
      "docked": false,
      "supercruise": false,
      "ship_type": "Unknown",
      "ship_name": "Unknown",
      "ship_pad_size": "M",
      "needs_large_pad": false,
      "star_pos": null,
      "controlling_power": null,
      "powerplay_state": null,
      "powers": [],
      "system_faction": null,
      "system_allegiance": null,
      "system_security": null,
      "hull_health": 1.0,
      "shields_up": true,
      "fuel_main": null,
      "cargo_count": 0,
      "legal_status": "Clean",
      "pips": [2.0, 2.0, 2.0],
      "gui_focus": 0
    },
    "initial_flags": {
      "docked": false,
      "landed": false,
      "landing_gear_down": false,
      "shields_up": true,
      "supercruise": false,
      "hardpoints_deployed": false,
      "cargo_scoop_open": false,
      "lights_on": false,
      "night_vision": false,
      "silent_running": false,
      "in_fighter": false,
      "in_srv": false,
      "in_main_ship": true
    },
    "flag_to_state": [
      "docked",
      "supercruise",
      "shields_up",
      "on_foot"
    ],
    "status_fields": {
      "fuel_main": "Fuel.FuelMain",
      "pips": { "path": "Pips", "list_scale": 0.5 },
      "gui_focus": "GuiFocus"
    },
    "companion_extractors": [
      {
        "file": "NavRoute.json",
        "fields": {
          "route_destination": { "path": "Route.-1.StarSystem" },
          "route_jumps": { "list_len_minus_1": "Route" }
        }
      },
      {
        "file": "Cargo.json",
        "fields": {
          "cargo_count": { "path": "Count", "cast": "int" },
          "cargo_items": {
            "list_map": "Inventory",
            "limit": 15,
            "fields": {
              "name": ["Name_Localised", "Name"],
              "count": "Count"
            }
          }
        }
      }
    ],
    "event_handlers": [
      {
        "events": ["Location", "FSDJump", "CarrierJump"],
        "set_state": {
          "star_system": "StarSystem",
          "body": "Body",
          "docked": { "path": "Docked", "default": false },
          "station": { "path": "StationName", "default": null, "allow_none": true },
          "star_pos": { "path": "StarPos", "require_len": 3 },
          "controlling_power": { "path": "ControllingPower", "default": null, "allow_none": true },
          "powerplay_state": { "path": "PowerplayState", "default": null, "allow_none": true },
          "powers": { "path": "Powers", "default": [] },
          "system_faction": { "path": ["SystemFaction.Name", "SystemFaction"], "default": null, "allow_none": true },
          "system_allegiance": { "path": "SystemAllegiance", "default": null, "allow_none": true },
          "system_security": { "path": ["SystemSecurity_Localised", "SystemSecurity"], "default": null, "allow_none": true }
        }
      },
      {
        "events": ["Docked"],
        "constants": { "docked": true },
        "set_state": {
          "station": "StationName",
          "star_system": "StarSystem"
        }
      },
      {
        "events": ["Undocked"],
        "constants": { "docked": false },
        "clear_state": ["station"]
      },
      {
        "events": ["SupercruiseEntry"],
        "constants": { "supercruise": true }
      },
      {
        "events": ["SupercruiseExit"],
        "constants": { "supercruise": false },
        "set_state": { "body": "Body" }
      },
      {
        "events": ["Loadout"],
        "set_state": {
          "ship_type": "Ship",
          "ship_name": "ShipName",
          "hull_health": { "path": "HullHealth", "default": 1.0 }
        },
        "derived_rules": [
          {
            "source_state": "ship_type",
            "target_state": "ship_pad_size",
            "default": "M",
            "bool_equals_state": { "needs_large_pad": "L" },
            "cases": [
              {
                "in": ["anaconda", "belugaliner", "cutter", "empire_trader", "federation_corvette", "federation_dropship_mkii", "independant_trader", "orca", "panthermkii", "type7", "type9", "type9_military"],
                "contains_any": ["anaconda", "corvette", "cutter", "beluga", "type7", "type9", "type10", "orca", "clipper", "panther"],
                "value": "L"
              },
              {
                "in": ["adder", "cobra_mkiii", "cobramkiii", "cobramkiv", "cobramkv", "diamondback", "diamondbackxl", "dolphin", "eagle", "empire_courier", "empire_eagle", "hauler", "sidewinder", "viper", "viper_mkiv", "vulture"],
                "value": "S"
              }
            ]
          }
        ]
      },
      {
        "events": ["ShieldState"],
        "set_state": { "shields_up": { "path": "ShieldsUp", "default": true } },
        "set_flags": { "shields_up": "ShieldsUp" }
      },
      {
        "events": ["Cargo"],
        "set_state": { "cargo_count": { "path": "Count", "default": 0 } }
      }
    ],
    "milestone_rules": [
      {
        "events": ["MissionAccepted"],
        "category": "mission",
        "fields": { "m_name": ["Name_Localised", "Name"], "dest_sys": "DestinationSystem", "dest_stn": "DestinationStation" },
        "template": "Accepted mission: {m_name} | Target: {dest_sys} ({dest_stn})"
      },
      {
        "events": ["MissionCompleted"],
        "category": "mission",
        "fields": { "m_name": ["Name_Localised", "Name"] },
        "template": "Completed mission: {m_name}"
      },
      {
        "events": ["CodexEntry", "FSSSignalDiscovered"],
        "category": "discovery",
        "fields": { "disc_name": ["Name_Localised", "SignalName_Localised", "SignalName", "Name"] },
        "require_field": "disc_name",
        "template": "Discovery recorded: {disc_name} in system {star_system}"
      },
      {
        "events": ["EngineerCraft"],
        "category": "intel",
        "template": "Engineering upgrade: {BlueprintName} (Grade {Level}) on {Slot}"
      },
      {
        "events": ["Interdicted", "EscapeInterdiction"],
        "category": "warning",
        "template": "Interdiction event involving {Interdictor}"
      }
    ],
    "summary_config": {
      "status_phases": [
