# Google OAuth 2.0 Credentials (Google Cloud Console -> APIs & Services -> Credentials)
AETHER_GOOGLE_CLIENT_ID=
AETHER_GOOGLE_CLIENT_SECRET=

# Microsoft OAuth 2.0 Credentials (Microsoft Entra ID / Azure Portal -> App Registrations)
AETHER_MICROSOFT_CLIENT_ID=5242daeb-e095-43c7-9979-57694e6983aa
AETHER_MICROSOFT_TENANT_ID=consumers


# Steam Web API Integration (Valve Steamworks)
STEAM_API_KEY=
STEAM_ID64=
